// ============================================
// SISTEMA DE PUNTOS
// ============================================

model UserPointsBalance {
  id                    Int      @id @default(autoincrement())
  user_id               Int      @unique
  total_earned          Int      @default(0)
  total_redeemed        Int      @default(0)
  total_expired         Int      @default(0)
  current_balance       Int      @default(0)
  last_earned_at        DateTime?
  last_redeemed_at      DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions          PointsTransaction[]
  
  @@index([user_id])
  @@index([current_balance])
}

model PointsTransaction {
  id                    Int                  @id @default(autoincrement())
  user_id               Int
  balance_id            Int
  transaction_type      PointsTransactionType
  points_amount         Int
  balance_before        Int
  balance_after         Int
  reference_type        String?
  reference_id          Int?
  description           String?
  expires_at            DateTime?
  expired               Boolean              @default(false)
  
  // ============================================
  // NUEVOS CAMPOS PARA TRANSFERENCIAS
  // ============================================
  transfer_from_user_id Int?                 // Usuario que envió (si es TRANSFER_RECEIVED)
  transfer_to_user_id   Int?                 // Usuario que recibió (si es TRANSFER_SENT)
  transfer_pair_id      Int?                 // ID de la transacción complementaria
  
  createdAt             DateTime             @default(now())
  
  user                  User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  balance               UserPointsBalance    @relation(fields: [balance_id], references: [id], onDelete: Cascade)
  
  @@index([user_id, createdAt])
  @@index([user_id, transaction_type])
  @@index([reference_type, reference_id])
  @@index([expires_at, expired])
  @@index([transfer_pair_id])  // ← NUEVO: Para vincular transacciones pareadas
}

enum PointsTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTMENT
  BONUS
  REFUND
  TRANSFER_SENT      // ← NUEVO: Usuario envió puntos
  TRANSFER_RECEIVED  // ← NUEVO: Usuario recibió puntos
}

