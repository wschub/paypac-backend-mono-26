model NotificationMessageQueue {
   id              Int      @id @default(autoincrement())
  user_id         Int
  template_code   String   // Código del template usado (ej: "REGISTRATION_VERIFY")
  email_delivery  String   // Email del destinatario
  email_subject   String   // Subject pre-renderizado
  email_body      String   @db.Text // HTML pre-renderizado
  send_at         DateTime?
  status          Int      @default(0) // 0: Pendiente, 1: Enviado, 2: Fallido
  message_result  String?  @db.Text // Respuesta de Brevo
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

   // ✅ Relaciones
  user     User                        @relation(fields: [user_id], references: [id])
  
  @@index([user_id])
  @@index([status])
  @@index([send_at])

}