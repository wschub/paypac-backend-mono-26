  subcategory     SubCategory? @relation(fields: [subcategory_id], references: [id], onDelete: Cascade)
  subgenre        Subgenre? @relation(fields: [subgenre_id], references: [id], onDelete: Cascade)
  
  @@unique([user_id, category_id, subcategory_id, subgenre_id])
  @@index([user_id])
  @@index([category_id])
  @@index([subcategory_id])
  @@index([subgenre_id])
}

