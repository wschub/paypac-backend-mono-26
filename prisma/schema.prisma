generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GeneralSettingsVariables {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                       Int                        @id @default(autoincrement())
  email                    String                     @unique
  name                     String
  last_name                String
  email_verified_at        DateTime?
  password                 String
  remember_token           String?
  phone_number             String
  phone_number_verified_at DateTime?
  num_doc                  String?
  type_doc                 DocType?
  role_default             String                     @default("CUSTOMER")
  company_id               Int?
  auth_method              String?
  provider_id              String?
  firebase_uid             String?                    @unique
  lang_user                String?
  verified_user            Int                        @default(0)
  status                   Int                        @default(0)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  role                     ROLES                      @default(CUSTOMER)
  fcm_token                String?
  fcm_updated              DateTime?
  birth_date               DateTime?
  city                     String?
  companiesRegistered      Company[]                  @relation("CompanyRegisteredBy")
  followedCompanies        CompanyFollwers[]
  promoterBalances         EventBalancePromoters[]    @relation("UserPromoterBalances")
  eventDiscounts           EventDcto[]                @relation("UserEventDiscounts")
  favorites                EventFavorites[]
  staffAssigned            EventStaffAssignment[]     @relation("StaffAssigner")
  staffAssignments         EventStaffAssignment[]     @relation("StaffAssignments")
  notifications            NotificationMessageQueue[]
  paymentMethods           PaymentMethodCard[]
  paymentMethodsUsers      PaymentMethodsUsers[]
  promoterCodes            PromoterCode[]             @relation("PromoterCodes")
  tickets                  Ticket[]
  transactions             Transactions[]
  company                  Company?                   @relation("UserCompany", fields: [company_id], references: [id])
}

model Company {
  id                   Int                @id @default(autoincrement())
  user_id_register     Int?
  type_identification  String?
  num_identification   String?
  website              String?
  address              String?
  country_id           Int?
  state_id             Int?
  city_id              Int?
  createdAt            DateTime           @default(now())
  approved_at          DateTime?
  updatedAt            DateTime           @updatedAt
  status               Int                @default(0)
  company_name         String             @unique
  company_description  String?
  company_email        String?            @unique
  company_logo         String?
  company_phone_number String?
  company_cover        String?
  company_presentation String             @default("")
  rating               Float              @default(0)
  nps_score            Int?
  city                 Cities?            @relation(fields: [city_id], references: [id])
  country              Countries?         @relation(fields: [country_id], references: [id])
  state                States?            @relation(fields: [state_id], references: [id])
  registeredBy         User?              @relation("CompanyRegisteredBy", fields: [user_id_register], references: [id])
  followers            CompanyFollwers[]
  liquidations         EventLiquidation[]
  users                User[]             @relation("UserCompany")
}

model CompanyFollwers {
  id         Int      @id @default(autoincrement())
  company_id Int
  user_id    Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([company_id, user_id])
  @@index([company_id])
  @@index([user_id])
}

model Section {
  id              Int                     @id @default(autoincrement())
  name_section    String
  icon            String?
  link            String?                 @unique
  level           Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  parent_id       Int?
  is_active       Boolean                 @default(true)
  section_order   Int                     @default(0)
  rolePermissions RoleSectionPermission[]
  parent          Section?                @relation("SectionTree", fields: [parent_id], references: [id])
  children        Section[]               @relation("SectionTree")
}

model RoleSectionPermission {
  section_id Int
  role       ROLES
  can_create Boolean @default(false)
  can_delete Boolean @default(false)
  can_edit   Boolean @default(false)
  can_export Boolean @default(false)
  can_view   Boolean @default(false)
  section    Section @relation(fields: [section_id], references: [id])

  @@id([role, section_id])
  @@index([role])
  @@index([role, section_id])
}

model Countries {
  id               Int        @id @default(autoincrement())
  name_country     String
  code             String
  phone_code       String
  currency         String
  language_default String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  categories       Category[]
  cities           Cities[]
  companies        Company[]
  states           States[]
}

model States {
  id         Int       @id @default(autoincrement())
  country_id Int
  name_state String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  cities     Cities[]
  companies  Company[]
  country    Countries @relation(fields: [country_id], references: [id])
}

model Cities {
  id         Int       @id @default(autoincrement())
  state_id   Int
  country_id Int
  name_city  String
  latitude   String
  longitude  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  country    Countries @relation(fields: [country_id], references: [id])
  state      States    @relation(fields: [state_id], references: [id])
  companies  Company[]
}

model Category {
  id            Int           @id @default(autoincrement())
  category_name String
  country_id    Int
  category_icon String?
  country       Countries     @relation(fields: [country_id], references: [id])
  events        Event[]
  subcategories SubCategory[]
}

model SubCategory {
  id               Int        @id @default(autoincrement())
  subcategory_name String
  category_id      Int
  events           Event[]
  category         Category   @relation(fields: [category_id], references: [id])
  subgenres        Subgenre[]
}

model Subgenre {
  id               Int         @id @default(autoincrement())
  subcategory_name String
  subcategory_id   Int
  events           Event[]
  subcategory      SubCategory @relation(fields: [subcategory_id], references: [id])
}

model Event {
  id                       Int                     @id @default(autoincrement())
  name                     String
  short_description        String
  description              String                  @default("")
  image                    String                  @default("")
  cover                    String                  @default("")
  date_event               DateTime
  place_address            String                  @default("")
  latitude                 String                  @default("")
  longitude                String                  @default("")
  currency                 String                  @default("COP")
  city                     String                  @default("")
  country                  String                  @default("")
  event_type               TypeEvent               @default(PUBLICO)
  type_venue               Places                  @default(SIN_NUMERAR)
  url_video                String                  @default("")
  organizer_id             Int                     @default(0)
  num_max_tickets          Int                     @default(0)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  status                   EVENT_STATUS            @default(CREATED)
  date_type                EventDateType           @default(SINGLE)
  apply_dcto               Boolean                 @default(false)
  allow_external_promoters Boolean                 @default(false)
  allow_paypac_promotion   Boolean                 @default(false)
  sales_channel            String                  @default("app")
  commission_to_charge     Float                   @default(0)
  commission_to_promoter   Float                   @default(0)
  numbered_place_id        Int?
  category_id              Int?
  subcategory_id           Int?
  subgenre_id              Int?
  commission_percentage    Float?
  date_checkin_close       DateTime?
  date_checkin_open        DateTime?
  date_end_event           DateTime?
  category                 Category?               @relation(fields: [category_id], references: [id])
  numbered_place           EventPlaces?            @relation(fields: [numbered_place_id], references: [id])
  subcategory              SubCategory?            @relation(fields: [subcategory_id], references: [id])
  subgenre                 Subgenre?               @relation(fields: [subgenre_id], references: [id])
  promoterBalances         EventBalancePromoters[]
  discounts                EventDcto[]
  favorites                EventFavorites[]
  liquidations             EventLiquidation[]
  localities               EventLocalities[]
  rewardRules              EventRewardRules[]
  seatStatuses             EventSeatStatus[]
  staffAssignments         EventStaffAssignment[]
  tickets                  Ticket[]
}

model EventStaffAssignment {
  id                 Int       @id @default(autoincrement())
  event_id           Int
  user_id            Int
  assigned_by        Int
  latitude           String?
  longitude          String?
  checked_in         Boolean   @default(false)
  checked_in_at      DateTime?
  assigned_at        DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  role_type          ROLES     @default(STAFF)
  door_identifier    String?
  invitation_pending Boolean   @default(false)
  invited_contact    String?
  assignedBy         User      @relation("StaffAssigner", fields: [assigned_by], references: [id])
  event              Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user               User      @relation("StaffAssignments", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([event_id])
  @@index([user_id])
}

model EventFavorites {
  id        Int      @id @default(autoincrement())
  user_id   Int
  event_id  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [event_id], references: [id])
  user      User     @relation(fields: [user_id], references: [id])
}

model EventDcto {
  id              Int              @id @default(autoincrement())
  user_id         Int
  event_id        Int
  name_dcto       String
  description     String?
  type_dcto       Int
  value_dcto      Int
  min_qty_tickets Int?
  max_qty_tickets Int?
  locality_id     Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  code            String?          @unique
  is_active       Boolean          @default(true)
  max_uses        Int?
  uses_count      Int              @default(0)
  event           Event            @relation(fields: [event_id], references: [id])
  locality        EventLocalities? @relation(fields: [locality_id], references: [id])
  user            User             @relation("UserEventDiscounts", fields: [user_id], references: [id])
}

model EventRewardRules {
  id                      Int                     @id @default(autoincrement())
  event_id                Int
  reward_type             EventRewardPromoters    @default(NONE)
  reward_percentage       Int?
  reward_amount           Int?
  min_qty_tickets         Int?
  min_amount_tickets      Int?
  locality_id             Int?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  apply_customer_discount Boolean                 @default(false)
  customer_discount_type  Int?
  customer_discount_value Int?
  commission_base         CommissionBase          @default(ON_DISCOUNTED)
  balances                EventBalancePromoters[]
  event                   Event                   @relation(fields: [event_id], references: [id])
  locality                EventLocalities?        @relation(fields: [locality_id], references: [id])
}

model EventBalancePromoters {
  id                 Int               @id @default(autoincrement())
  event_id           Int
  promoter_id        Int
  reward_rule_id     Int?
  reward_amount      Int?
  reward_description String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  status             Int               @default(0)
  expiration_date    DateTime?
  invoice_id         Int?
  tickets_sold       Int               @default(0)
  event              Event             @relation(fields: [event_id], references: [id])
  promoter           User              @relation("UserPromoterBalances", fields: [promoter_id], references: [id])
  rewardRule         EventRewardRules? @relation(fields: [reward_rule_id], references: [id])
}

model PromoterCode {
  id          Int       @id @default(autoincrement())
  promoter_id Int
  code        String    @unique
  is_active   Boolean   @default(true)
  uses_count  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  invoices    Invoice[]
  promoter    User      @relation("PromoterCodes", fields: [promoter_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([promoter_id])
  @@index([code])
}

model EventLiquidation {
  id                  Int                    @id @default(autoincrement())
  company_id          Int
  event_id            Int
  num_liquidation     String                 @unique
  gross_amount        Float
  paypac_commission   Float
  promoter_commission Float                  @default(0)
  refunds             Float                  @default(0)
  net_amount          Float
  status              EventLiquidationStatus @default(PENDING)
  liquidation_date    DateTime
  paid_at             DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  company             Company                @relation(fields: [company_id], references: [id])
  event               Event                  @relation(fields: [event_id], references: [id])

  @@index([company_id])
  @@index([event_id])
  @@index([status])
}

model EventLocalities {
  id                   Int                @id @default(autoincrement())
  event_id             Int
  name_locality        String
  bkg_color            String
  title_color          String
  text_color           String
  title_color_location String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  num_max_tickets      Int?               @default(0)
  num_tickets_sold     Int?               @default(0)
  require_num_tickets  Boolean            @default(false)
  discounts            EventDcto[]
  event                Event              @relation(fields: [event_id], references: [id])
  rewardRules          EventRewardRules[]
  stages               EventStages[]
}

model EventStages {
  id           Int             @id @default(autoincrement())
  locality_id  Int
  stage_name   String
  date_start   DateTime
  date_end     DateTime
  price_ticket Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  locality     EventLocalities @relation(fields: [locality_id], references: [id])
}

model EventPlaces {
  id         Int              @id @default(autoincrement())
  name_place String
  type_place TypePlaces
  capacity   Int
  createdAt  DateTime         @default(now())
  place_type Places
  updatedAt  DateTime         @updatedAt
  map_place  Json?
  events     Event[]
  zones      EventPlaceZone[]

  @@index([type_place])
}

model EventPlaceZone {
  id       Int             @id @default(autoincrement())
  place_id Int
  name     String
  capacity Int
  rows     EventPlaceRow[]
  place    EventPlaces     @relation(fields: [place_id], references: [id])

  @@index([place_id])
}

model EventPlaceRow {
  id      Int              @id @default(autoincrement())
  zone_id Int
  name    String
  zone    EventPlaceZone   @relation(fields: [zone_id], references: [id])
  seats   EventPlaceSeat[]

  @@index([zone_id])
}

model EventPlaceSeat {
  id          Int               @id @default(autoincrement())
  row_id      Int
  seat_number String
  status      SeatStatus        @default(ACTIVE)
  row         EventPlaceRow     @relation(fields: [row_id], references: [id])
  eventStatus EventSeatStatus[]

  @@unique([row_id, seat_number])
  @@index([row_id])
  @@index([status])
}

model EventSeatStatus {
  id         Int             @id @default(autoincrement())
  seat_id    Int
  event_id   Int
  status     SeatEventStatus @default(AVAILABLE)
  held_until DateTime?
  event      Event           @relation(fields: [event_id], references: [id])
  seat       EventPlaceSeat  @relation(fields: [seat_id], references: [id])

  @@unique([seat_id, event_id])
  @@index([event_id, status])
  @@index([event_id])
}

model PaymentMethodsUI {
  id            Int      @id @default(autoincrement())
  method_name   String
  mehtod_img    String
  method_status Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PaymentMethodsUsers {
  id            Int      @id @default(autoincrement())
  user_id       Int
  user_uid      String
  method_id     Int
  method_status Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id])
}

model PaymentMethodCard {
  id               Int     @id @default(autoincrement())
  user_id          Int
  user_uid         String
  id_token         String
  created_at       String
  brand            String
  name             String
  last_four        String
  bin              String
  exp_year         String
  exp_month        String
  card_holder      String
  created_with_cvc Boolean @default(false)
  expires_at       String
  validity_ends_at String
  user             User    @relation(fields: [user_id], references: [id])
}

model Invoice {
  id                         Int              @id @default(autoincrement())
  user_id                    Int
  user_uid                   String
  num_invoice                String
  user_name                  String
  user_lastname              String
  user_num_doc               String
  user_type_doc              DocType          @default(CC)
  num_items                  Int
  event_id                   Int
  apply_discount             Int              @default(0)
  discount_type              Int              @default(0)
  discount_value             Int              @default(0)
  total_ticket_dcto          Int              @default(0)
  total_ticket_regular       Int
  total                      Int
  status                     InvoiceStatus
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  refunded_amount            Int?
  refunded_at                DateTime?
  paypac_commission_pct      Float?           @default(0)
  paypac_commission_amount   Int?             @default(0)
  promoter_commission_amount Int?             @default(0)
  promoter_code_id           Int?
  customer_UUID_phone        String?
  promoterCode               PromoterCode?    @relation(fields: [promoter_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoiceTickets             InvoiceTickets[]
}

model InvoiceTickets {
  id                   Int      @id @default(autoincrement())
  invoice_id           Int
  stage_id             Int
  stage_name           String
  locality_id          Int
  locality_name        String
  qty_tickets          Int
  price_ticket         Int
  apply_discount       Int      @default(0)
  discount_type        Int      @default(0)
  discount_value       Int      @default(0)
  total_ticket_dcto    Int      @default(0)
  total_ticket_regular Int
  total_ticket_paid    Int
  purchase_date        DateTime
  status_item          Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  invoice              Invoice  @relation(fields: [invoice_id], references: [id])
}

model Ticket {
  id                       Int          @id @default(autoincrement())
  transaction_id           Int
  event_id                 Int
  customer_id              Int
  customer_uid             String
  customer_ID_phone        String
  reference_ticket         String
  booking_ticket           String
  token_ticket             String
  ticket_first_time        Int          @default(1)
  ev_name                  String
  ev_short_description     String
  ev_cover                 String       @default("")
  ev_date_event            DateTime     @default(now())
  ev_place_address         String       @default("")
  ev_event_type            TypeEvent    @default(PUBLICO)
  ev_type_venue            Places       @default(SIN_NUMERAR)
  ev_place_seat            String       @default("")
  ev_organizer_id          Int          @default(0)
  loc_id_locality          Int
  loc_name_locality        String
  loc_bkg_color            String
  loc_title_color          String
  loc_text_color           String
  loc_title_color_location String
  created_at               DateTime     @default(now())
  updated_at               DateTime     @updatedAt
  used_at                  DateTime?
  status_ticket            TicketStatus @default(PENDING)
  ev_status                EVENT_STATUS @default(CREATED)
  first_name_user          String?
  last_name_user           String?
  read_by_user             Int?
  device_uuid              String?
  totp_secret              String?
  user_num_doc             String?
  user_type_doc            DocType?
  nfc_id                   String?
  device_public_key        String?
  customer                 User         @relation(fields: [customer_id], references: [id])
  event                    Event        @relation(fields: [event_id], references: [id])
}

model TicketTransaction {
  id                       Int               @id @default(autoincrement())
  ticket_id                Int
  from_customer_id         Int
  from_customer_token      String
  from_customer_uid        String
  from_customer_UUID_phone String
  reference_ticket         String
  booking_ticket           String
  to_customer_id           Int
  to_customer_token        String
  to_customer_uid          String
  to_customer_UUID_phone   String
  type_transaction         String
  ev_name                  String
  transaction_description  String
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt
  completed_at             DateTime?
  status_ticket            TransactionStatus @default(PENDING)
}

model Transactions {
  id                  Int      @id @default(autoincrement())
  user_id             Int
  user_uid            String
  invoice_id          String
  created_at          DateTime
  finalized_at        DateTime
  amount_in_cents     Int
  reference           String
  customer_email      String
  currency            String
  payment_method_type String
  payment_method      Json
  status              String
  status_message      String
  billing_data        String
  shipping_address    String
  redirect_url        String
  payment_source_id   String
  payment_link_id     String
  customer_data       String
  bill_id             String
  taxes               String[]
  tip_in_cents        String
  meta                Json
  user                User     @relation(fields: [user_id], references: [id])
}

model NotificationMessageQueue {
  id             Int       @id @default(autoincrement())
  user_id        Int
  email_delivery String
  send_at        DateTime?
  status         Int       @default(0)
  message_result String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  email_subject  String
  email_body     String
  template_code  String
  user           User      @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([status])
  @@index([send_at])
}

/// *
enum ROLES {
  PAYPAC
  ORGANIZER
  STAFF
  STAFF_PROMOTER
  PROMOTER
  CUSTOMER
}

enum EVENT_STATUS {
  CREATED
  APPROVED
  SCHEDULED
  ACTIVE
  CANCELED
  RE_SCHEDULED
  FINALIZED
}

enum EventDateType {
  SINGLE
  MULTIPLE
  RANGE_DATE
  RANGE_DATE_EXCEPT
  EXPLICIT_DATES
}

enum EventRewardPromoters {
  NONE
  PERCENTAGE
  FIXED_AMOUNT
  GUEST_LIST
  TICKET_REWARD
  CASH_REWARD
  CONSUMPTION_REWARD
}

enum CommissionBase {
  ON_ORIGINAL
  ON_DISCOUNTED
}

enum EventLiquidationStatus {
  PENDING
  PAID
  OVERDUE
}

enum TypeEvent {
  PUBLICO
  PRIVADO
}

enum Places {
  NUMERADO
  SIN_NUMERAR
}

enum SeatStatus {
  ACTIVE
  BLOCKED_MAINTENANCE
}

enum SeatEventStatus {
  AVAILABLE
  HELD
  SOLD
  BLOCKED
}

enum TypePlaces {
  CLUB
  DISCOTECA
  TEATRO
  CINE
  ESTADIO
}

enum InvoiceStatus {
  ISSUED
  PROCESSING
  PAID
  PENDING
  REJECTED
  CANCELED
  REFUNDED
}

enum DocType {
  CC
  CE
  PA
  TI
  NIT
  SSN
}

enum TicketStatus {
  PENDING
  PAID
  ACTIVE
  USED
  FROZEN
  TRANSFERRED
  CANCELED
  EXPIRED
  ON_SALE
}

enum TransactionStatus {
  PENDING
  FROZEN
  PAID
  ACCEPTED
  RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
  ON_SALE
}
